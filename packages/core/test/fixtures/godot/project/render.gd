extends SceneTree

func _initialize() -> void:
	call_deferred("verify_render")

func verify_render() -> void:
	var viewport = SubViewport.new()
	viewport.size = Vector2i(256,64)
	viewport.transparent_bg = true
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	root.add_child(viewport)
	viewport.add_child(load("res://smap/fixture.tscn").instantiate())
	await process_frame
	await RenderingServer.frame_post_draw
	var actual = viewport.get_texture().get_image()
	if actual == null or actual.is_empty():
		push_error("Renderer returned no image")
		quit(1)
		return
	# Pinned PNG generated by an independent explicit corner-permutation oracle.
	var golden = Image.load_from_file("res://golden.png")
	for y in range(64):
		for x in range(256):
			var expected = golden.get_pixel(x,y)
			if not actual.get_pixel(x,y).is_equal_approx(expected):
				push_error("Golden render differs at (%d,%d): %s, expected %s" % [x,y,actual.get_pixel(x,y),expected])
				quit(1)
				return
	actual.save_png("res://.godot/rendered.png")
	print("GODOT_RENDER_OK: 16384 pixels, all eight D4 orientations, atlas margins/spacing, hidden layer, transparent collision, sparse holes")
	quit(0)
