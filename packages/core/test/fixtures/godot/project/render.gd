extends SceneTree

func _initialize() -> void:
	call_deferred("verify_render")

func verify_render() -> void:
	if not await compare("res://smap/fixture/fixture.tscn", "res://golden.png", Vector2i(256,64), "rendered"):
		quit(1)
		return
	if not await compare("res://smap/native/native.tscn", "res://native-golden.png", Vector2i(768,640), "native-rendered"):
		quit(1)
		return
	print("GODOT_RENDER_OK: 507904 pixels; baseline D4 and mixed 16/32/oversized/rectangular/odd extents, all eight orientations")
	quit(0)

func compare(scene: String, golden_path: String, size: Vector2i, output: String) -> bool:
	var viewport = SubViewport.new()
	viewport.size = size
	viewport.transparent_bg = true
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	root.add_child(viewport)
	viewport.add_child(load(scene).instantiate())
	await process_frame
	await RenderingServer.frame_post_draw
	var actual = viewport.get_texture().get_image()
	if actual == null or actual.is_empty():
		push_error("Renderer returned no image")
		return false
	# Pinned PNG generated by an independent explicit corner-permutation oracle.
	var golden = Image.load_from_file(golden_path)
	for y in range(size.y):
		for x in range(size.x):
			var expected = golden.get_pixel(x,y)
			if not actual.get_pixel(x,y).is_equal_approx(expected):
				push_error("Golden render differs at (%d,%d): %s, expected %s" % [x,y,actual.get_pixel(x,y),expected])
				return false
	actual.save_png("res://.godot/%s.png" % output)
	viewport.queue_free()
	return true
