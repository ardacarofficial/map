{
  "name": "smap",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @smap/editor dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test:e2e": "pnpm --filter @smap/e2e exec playwright test",
    "perf": "pnpm --filter @smap/e2e exec playwright test -c perf/playwright.config.ts",
    "desktop:dev": "pnpm --filter @smap/desktop tauri dev",
    "desktop:build": "pnpm --filter @smap/desktop tauri build",
    "i18n:gen": "pnpm --filter @smap/editor i18n:gen",
    "i18n:import-legacy": "node --experimental-strip-types packages/editor/scripts/i18n-migrate.ts --files"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
